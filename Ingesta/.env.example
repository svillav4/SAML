# Credenciales de acceso a Licitaciones.Info (servicio LOGIN)
LICITACIONES_EMAIL=tu_correo@dominio.com
LICITACIONES_PASSWORD=tu_password

# Pais/subdominio a usar: colombia, ecuador, panama, costa_rica, chile, peru
LICITACIONES_COUNTRY=colombia

# Opcional: IDs de perfiles de negocio separados por coma (ej: 130779,130778).
# Si se deja vacio, extract.py los obtiene automaticamente via /perfiles/consultar
LICITACIONES_PERFILES=

# Maximo de registros por pagina que se piden a la API (tope: 30)
LICITACIONES_PAGE_LIMIT=30

# Opcional: texto a buscar en el nombre del proceso (campo "Nombre")
LICITACIONES_KEYWORD=

# Opcional: filtrar por estado del proceso (campo "estado_agrupado"),
# ej: Adjudicado, Abierto, Cerrado, Desierto (usa el valor tal como lo
# devuelve la API en las licitaciones que ya has consultado).
LICITACIONES_ESTADO=Adjudicado

# Opcional (avanzado): filtros adicionales en crudo, como JSON de una sola
# linea. Se combinan con LICITACIONES_KEYWORD y LICITACIONES_ESTADO.
# ej: {"departamento": "Antioquia"}
LICITACIONES_QUERY_EXTRA=

# Opcional: filtrar solo procesos nuevos (true/false)
LICITACIONES_FILTRAR_NUEVOS=true

# Campos extra a solicitar a la API (por defecto: fechas y documentos del proceso)
LICITACIONES_CAMPOS_ADICIONALES=fechas,documentos
