# Clasificacion con LLM (OpenAI) de las entidades sin regla de reparto.
# Copia este archivo como Transformacion/.env (no se versiona) y escribe tu clave.
OPENAI_API_KEY=
# Modelo de OpenAI (opcional). Por defecto: gpt-5-mini
OPENAI_MODEL=
# true/false: usar el LLM (por defecto true si hay clave)
SAML_USAR_LLM=true
