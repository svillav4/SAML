	column Nota
		dataType: string
		isHidden
		lineageTag: 61e42f50-02d0-5449-848b-2f1fc0a2832f
		summarizeBy: none
		sourceColumn: Nota

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = #table(type table [Nota = text], {})
				in
				    Origen

	annotation PBI_ResultType = Table
