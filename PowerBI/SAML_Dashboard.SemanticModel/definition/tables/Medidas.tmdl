	measure 'Ficha · Proponentes' = SUM(FactProcesos[Num. proponentes])
		formatString: 0
		displayFolder: 6. Ficha
		lineageTag: d757a190-260d-5c9d-b09a-d7a88d7fe127

	measure 'Ficha · Ganadores' = SUM(FactProcesos[Num. ganadores])
		formatString: 0
		displayFolder: 6. Ficha
